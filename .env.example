GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# --- Bản vá P0/P1: tùy chọn mới (để trống/mặc định cũng chạy được) ---
# Đặt key này để bật kiểm tra X-API-Key cho /api/v1/* (đồng thời
# đặt NEXT_PUBLIC_AIRA_API_KEY cùng giá trị trong frontend/.env.local)
AIRA_API_KEY=
# Giới hạn dung lượng PDF upload (MB), vượt quá trả HTTP 413
AIRA_MAX_UPLOAD_MB=50
# =1 để bật OCR fallback cho PDF scan (cần cài thêm pytesseract, Pillow và tesseract)
AIRA_OCR=0
# Trần số request chat/upload mỗi phút cho mỗi IP (0 = tắt rate limit)
AIRA_RATE_LIMIT_PER_MIN=30
# Danh sách origin được phép gọi API từ trình duyệt, phân tách bằng
# dấu phẩy; để trống = mặc định chỉ http://localhost:3000 và
# http://127.0.0.1:3000 (đủ cho chạy local)
AIRA_CORS_ORIGINS=
# Mật khẩu Postgres khi chạy docker compose: compose đọc biến này
# từ .env/shell để đặt POSTGRES_PASSWORD và lắp DATABASE_URL cho
# backend — bắt buộc đặt một giá trị riêng khi deploy, đừng dùng
# mật khẩu mẫu
POSTGRES_PASSWORD=
